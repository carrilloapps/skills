{
  "devils-advocate-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|mcp.*",
        "hooks": [
          { "type": "command", "command": "node .agents/hooks/devils-advocate/guard.mjs", "timeout": 10 }
        ]
      }
    ]
  }
}
