# Normalize line endings on commit
* text=auto

# Force LF for shell scripts (must be LF for bash compatibility)
scripts/*.sh text eol=lf

# Force LF for GitHub Actions workflows
.github/workflows/*.yml text eol=lf

# Multi-OS skill scripts: LF everywhere so bash works on Windows checkouts;
# PowerShell 5.1+ reads LF scripts fine.
*.sh text eol=lf
*.ps1 text eol=lf
tests/scripts/expected/** text eol=lf

# Extensionless hook scripts executed by bash (Cline PreToolUse)
integrations/cline/hooks/PreToolUse text eol=lf
